# Configuracion General
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Base de datos MySQL local (Servicio MySQL92 en 127.0.0.1)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=ecommerce_pass
MYSQL_DB=ecommerce_botica
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=5

# Broker de Mensajeria RabbitMQ local
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Seguridad y Autenticacion (ADR-0004, ADR-0017, ADR-0018)
# IMPORTANTE: en produccion definir un secreto fuerte y unico; nunca commitear el real.
JWT_SECRET=insecure-dev-secret-cambiar-en-produccion
JWT_EXPIRES_SECONDS=3600
FRONTEND_BASE_URL=https://localhost:5173

# Modelo de lectura del catalogo (Meilisearch, ADR-0005/0006)
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=productos
CATALOG_SEED_FALLBACK=true

# Carrito/reservas (ADR-0011/0016)
CART_RESERVATION_TTL_SECONDS=86400
GUEST_MAX_UNITS_PER_SKU=3
GUEST_MAX_DISTINCT_PRODUCTS=10
GUEST_MAX_RESERVED_UNITS_PER_IP=15
CART_ADD_BURST=5
CHECKOUT_RATE_LIMIT_PER_MINUTE=3

# Pasarela de pagos Stripe Sandbox / modo test (ADR-0013, ADR-0019)
# Placeholders: reemplazar por claves de TEST reales en el entorno; nunca commitear secretos.
STRIPE_SECRET_KEY=sk_test_REEMPLAZAR
STRIPE_PUBLISHABLE_KEY=pk_test_REEMPLAZAR
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZAR
STRIPE_API_URL=https://api.stripe.com/v1
CHECKOUT_PRORROGA_SECONDS=600
PEDIDO_SECUENCIA_BASE=10000

# OCR de recetas medicas (ADR-0008, ADR-0015)
# Ruta al binario de Tesseract instalado en el servidor Windows; dejar vacio si
# esta en PATH. Nunca incluir datos de salud ni rutas de documentos reales.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_TEST_MODE=false
OCR_WORKER_ENABLED=true
OCR_POLL_INTERVAL_MS=1500
OCR_CONFIDENCE_THRESHOLD=65

# Despacho logistico y seed RBAC (HU-08). Sin credenciales reales en el repositorio.
SEED_RBAC_USERS=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_MOTORIZADO_EMAIL=
SEED_MOTORIZADO_PASSWORD=
