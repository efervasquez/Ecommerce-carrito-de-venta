# Configuracion General
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Base de datos MySQL local (Servicio MySQL92 en 127.0.0.1)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=ecommerce_pass
MYSQL_DB=ecommerce_botica
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=5

# Broker de Mensajeria RabbitMQ local
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Seguridad y Autenticacion (ADR-0004, ADR-0017, ADR-0018)
# IMPORTANTE: en produccion definir un secreto fuerte y unico; nunca commitear el real.
JWT_SECRET=insecure-dev-secret-cambiar-en-produccion
JWT_EXPIRES_SECONDS=3600
FRONTEND_BASE_URL=https://localhost:5173

# Modelo de lectura del catalogo (Meilisearch, ADR-0005/0006)
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=productos
CATALOG_SEED_FALLBACK=true
