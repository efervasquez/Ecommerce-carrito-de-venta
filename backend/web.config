<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Manejador HttpPlatformHandler para enrutar trafico HTTP a FastAPI / Uvicorn en Windows/IIS 10 (ADR-0001, ADR-0002) -->
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    
    <httpPlatform processPath="%PYTHON_HOME%\python.exe"
                  arguments="-m uvicorn src.main:app --port %HTTP_PLATFORM_PORT% --workers 1"
                  stdoutLogEnabled="true"
                  stdoutLogFile="..\logs\iis-stdout.log"
                  startupTimeLimit="60"
                  requestTimeout="00:04:00">
      <environmentVariables>
        <environmentVariable name="APP_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>

    <!-- Filtrado de peticiones y proteccion de payload perimetral (ADR-0019) -->
    <security>
      <requestFiltering>
        <!-- Limite de payload a 10 MB (10485760 bytes) para recepcion de recetas medicas -->
        <requestLimits maxAllowedContentLength="10485760" maxQueryString="4096" maxUrl="4096" />
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="POST" allowed="true" />
          <add verb="PUT" allowed="true" />
          <add verb="DELETE" allowed="true" />
          <add verb="OPTIONS" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>

    <!-- Cabeceras de seguridad perimetrales segun ADR-0015 y ADR-0019 -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' https://js.stripe.com; frame-src 'self' https://js.stripe.com https://hooks.stripe.com; connect-src 'self' https://api.stripe.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
